{
  "num_classes": 4,
  "image_size": 224,
  "use_lora": true,
  "lora_rank": 16,
  "lora_alpha": 32,
  "drop_path_rate": 0.2,
  "checkpoint_dir": "outputs/checkpoints",
  "auto_download": true,
  "epochs": 30,
  "batch_size": 16,
  "num_workers": 2,
  "learning_rate": 0.0005,
  "weight_decay": 0.05,
  "warmup_epochs": 5,
  "grad_clip": 1.0,
  "layer_decay": 0.65,
  "loss_type": "weighted_ce",
  "label_smoothing": 0.1,
  "amp_enabled": true,
  "amp_dtype": "bfloat16",
  "gradient_checkpointing": true,
  "save_dir": "outputs/runs",
  "log_every_n_batches": 50,
  "seed": 42,
  "splits_dir": "outputs/splits"
}